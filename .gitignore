# ── 密钥与环境：绝对不要提交 ──
.env

# ── 用户创作产物（正文 / 大纲 / 记忆库，属于个人内容）──
outputs/
outputs_web/

# ── 本机 Agent 工作记忆：含本地绝对路径（盘符 / 用户名）与开发过程笔记，
#    属于作者本机环境，不适合随仓库公开 ──
.workbuddy/

# ── 内部调研笔记：含竞品对比与本项目自述短板，只作本地参考，不随仓库公开 ──
docs/优化建议-对比同类项目.md

# ── 历史备份（本地留档即可，见 _backup/README.txt）──
_backup/
*.bak
*.bak_*

# ── 非商用授权字体：已不再被 fonts.css 引用，不进版本库 ──
# （当前页面用的是思源宋体/黑体，SIL OFL 可商用）
web/static/fonts/yinpin-hongmengti.ttf

# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 临时验证产物：e2e 脚本、无头浏览器用户目录、一次性校验脚本 ──
_tmp_check/
.tmp_check/
