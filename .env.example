# 复制本文件为 .env 后按需修改；不填也能跑（网页端可在界面上填平台/地址/模型/Key）。
#
# 优先级：真实环境变量 > .env 里的值 > config.py 里的默认值。
# 也就是说，命令行 export 的值不会被 .env 覆盖。

# ── 接口地址与密钥 ────────────────────────────────────────────
# 官方 API：只填 Key 即可，地址留空用默认
# 本地模型：地址指向 OpenAI 兼容服务，Key 随便填（本地服务通常不校验）
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 模型 ──────────────────────────────────────────────────────
# 网页端下拉里选好平台与模型后，这里的值就不生效了（前端会把选择下发给后端）
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 生成行为 ──────────────────────────────────────────────────
# 深度思考。写作类任务收益有限，却让耗时变成数倍，且容易把输出额度全耗在
# 思考里导致正文为空 → 默认关闭。1 = 开启
DEEPSEEK_THINKING=0

# 单次调用最大输出 token。必须设：JSON 模式下模型可能输出「无尽空白」直到上限，
# 表现为前端长时间卡住；有上限才能快速失败
DEEPSEEK_MAX_TOKENS=8192

# 「空闲超时」（秒）——注意语义，不是请求总时长。
# 所有请求都走流式，该值表示「相邻两段数据之间」最长等多久；
# 只要模型还在吐字就不会超时（思考分片也算有数据流动）
DEEPSEEK_TIMEOUT=90

# 失败重试次数。默认 0：流式超时下自动重试只会让用户白等一倍时间
DEEPSEEK_MAX_RETRIES=0

# 校对结果彻底解析不了时的策略：
#   1（默认）= 放行 —— 跳过校对直接润色，界面醒目告警，保住已写好的正文
#   0        = 严格 —— 直接中断，宁可失败也不让未经校验的章节过关
STORY_REVIEW_FAIL_OPEN=1

# ── 记忆与伏笔 ────────────────────────────────────────────────
# 写第 N 章时，从历史摘要里检索多少条进 prompt（这是「检索项」的量；
# 必带项——未回收伏笔 / 人物快照 / 物资账本——不受此值限制）
STORY_MEMORY_TOP_K=8

# 「必带项」里未回收伏笔的条数上限。超出后按「deadline 近 → 最久没推进」排序截断，
# 被截掉的至少保留 id，因此记忆结算仍能看到全量伏笔池、不会漏记
STORY_MEMORY_MUST_HAVE_MAX=12

# 某条伏笔连续这么多章既没推进（progressing）也没回收（resolved）就在看板告警。
# 伏笔烂尾是长篇最伤读者的问题，这个值用来兜住它
STORY_FORESHADOW_STALE=5

# ── 去 AI 味 ──────────────────────────────────────────────────
# 规则层体检（纯代码统计，不消耗 token）：套话密度 / 句长标准差 / 比喻密度 /
# 收束句占比超阈值只在看板告警，不自动改稿
STORY_STYLE_CHECK=1
# 模型层：给润色环节追加「去 AI 腔」指令（不增加调用次数）
STORY_DESLOP=1

# ── 校对拆分 ──────────────────────────────────────────────────
# 校对拆成三路并行 specialist；关掉「节奏/篇幅」这一路可省一次调用
# （节点仍然存在，只是直接返回空，不动图结构）
STORY_REVIEW_PACING=1

# ── 说明 ──────────────────────────────────────────────────────
# 校对打回重写的最大轮数（MAX_REVISION_ROUNDS）与各角色 temperature
# 属于代码内常量，见 config.py，不通过环境变量覆盖。
